
{
  "name": "gerador-de-landing-pages-com-ia",
  "keep_vars": true,
  "main": "worker/index.js",
  "compatibility_date": "2026-10-28",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/gerar"]
  },

  "ratelimits": [
    {
      "name": "LIMITE_GERACAO",
      "namespace_id": "2001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "COTA_DIARIA",
        "class_name": "CotaDiaria"
      }
    ]
  },

  "exports": {
    "CotaDiaria": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  
"previews": {
  "vars": {
    "ENABLE_GENERATION": "true"
  },
  "ratelimits": [

      {
        "name": "LIMITE_GERACAO",
        "namespace_id": "2002",
        "simple": {
          "limit": 20,
          "period": 60
        }
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "COTA_DIARIA",
          "class_name": "CotaDiaria"
        }
      ]
    }
  }
}
