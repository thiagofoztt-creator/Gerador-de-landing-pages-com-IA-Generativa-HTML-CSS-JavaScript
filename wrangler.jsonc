
{
  "name": "gerador-de-landing-pages-com-ia",
  "keep_vars": true,
  "main": "worker/index.js",
  "compatibility_date": "2026-10-28",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/gerar",
      "/api/dev/db-health",
      "/api/auth/register"
    ]
  },

  "ratelimits": [
    {
      "name": "LIMITE_GERACAO",
      "namespace_id": "2001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "COTA_DIARIA",
        "class_name": "CotaDiaria"
      }
    ]
  },

  "exports": {
    "CotaDiaria": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "previews": {
    "vars": {
      "ENABLE_GENERATION": "true"
    },

    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "thiagoia-dev",
        "database_id": "0b97d5c8-384c-4a08-b058-843323ee729f"
      }
    ],

    "ratelimits": [
      {
        "name": "LIMITE_GERACAO",
        "namespace_id": "2002",
        "simple": {
          "limit": 20,
          "period": 60
        }
      },
      {
        "name": "AUTH_RATE_LIMIT",
        "namespace_id": "2003",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ],

    "durable_objects": {
      "bindings": [
        {
          "name": "COTA_DIARIA",
          "class_name": "CotaDiaria"
        }
      ]
    }
  }
}
