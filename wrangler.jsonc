
{
  "name": "gerador-landing-pages-ia",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/gerar"]
  },
  "ratelimits": [
    {
      "name": "LIMITE_GERACAO",
      "namespace_id": "2001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
